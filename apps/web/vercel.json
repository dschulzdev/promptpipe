{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"framework": "vite",
	"rewrites": [
		{
			"source": "/backend",
			"destination": "https://promptpipe-backend.vercel.app/"
		},
		{
			"source": "/backend/:rest([A-Za-z0-9]+(?:/[A-Za-z0-9]+)*)",
			"destination": "https://promptpipe-backend.vercel.app/:rest"
		}
	]
}
