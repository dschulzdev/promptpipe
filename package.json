{
	"name": "promptpipe",
	"private": true,
	"type": "module",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"check": "turbo check",
		"prepare": "husky",
		"dev": "turbo dev",
		"build": "turbo build",
		"check-types": "turbo check-types",
		"dev:native": "turbo -F native dev",
		"dev:web": "turbo -F web dev",
		"dev:server": "turbo -F server dev",
		"db:migrate": "turbo -F server db:migrate:prod"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.2.5",
		"husky": "^9.1.7",
		"lint-staged": "^15.5.2",
		"turbo": "^2.5.8"
	},
	"packageManager": "pnpm@10.13.1"
}
